$Macro SRCDIR		"..\.."

$Configuration
{
	$General
	{
        $AdditionalProjectDependencies	"luasocket;lua54;libpng;lzma"
	}

	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\lua;$SRCDIR\luasocket\src"
		$PreprocessorDefinitions		"$BASE"
	}
}

