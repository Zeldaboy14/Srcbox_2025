#include "lux_common_vs_fxc.h"

struct VS_INPUT
{
    float3 position : POSITION;
    float3 normal   : NORMAL;
    float2 texcoord : TEXCOORD0;
};

struct VS_OUTPUT
{
    float4 pos : POSITION;
	float fogCoord  : FOG;
};

VS_OUTPUT main(VS_INPUT IN)
{
    VS_OUTPUT OUT;
    //float4 worldPos = mul(cModelViewProj, float4(IN.position, 1.0));
	float4 worldPos = mul(float4(IN.position, 1.0), cModelViewProj);
    OUT.pos = worldPos;
    OUT.fogCoord = worldPos.z / worldPos.w;
    return OUT;
}