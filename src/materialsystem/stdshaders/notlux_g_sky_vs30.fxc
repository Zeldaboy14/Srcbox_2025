//===================== File of the Srcbox Shader Project (Under LUX) =====================//
//
//	Recreation of Garry's Mod g_sky_vs20.
//
//	The engine draws the skybox quads in world space, so the vertex position
//	IS the world position: GMod applies cViewProj only (no model matrix) and
//	hands the raw position to the pixel shader.
//
//=========================================================================================//

#include "lux_common_vs_fxc.h"

struct VS_INPUT
{
	float4 vPos			: POSITION;
};

struct VS_OUTPUT
{
	float4 ProjPos		: POSITION;
	float3 WorldPos		: TEXCOORD0;
};

VS_OUTPUT main(const VS_INPUT v)
{
	VS_OUTPUT o;
	o.ProjPos	= mul(float4(v.vPos.xyz, 1.0f), cViewProj);
	o.WorldPos	= v.vPos.xyz;
	return o;
}
