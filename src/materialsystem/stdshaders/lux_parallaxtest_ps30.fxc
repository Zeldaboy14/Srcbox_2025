sampler Sampler_ParallaxTexture : register(s1);

//==========================================================================//
//	PS Input
//==========================================================================//
struct PS_INPUT
{
	// HACKHACK: For some reason Scell's compiler allows the use of SV_POSITION
	// We can abuse this so we don't need to pass ProjPos separately!!
	float2 ProjPos					:	SV_POSITION;
	float4 WorldPos_ProjPosZ		:	TEXCOORD0;
    float4 BaseDetailTexCoord		:	TEXCOORD1;
//	float4 NormalEMMTexCoord		:	TEXCOORD2;
	float3x3 TBN_Matrix				:	TEXCOORD3;
	//									TEXCOORD4
	//									TEXCOORD5
	float4 LightmapTexCoord			:	TEXCOORD6; // Two more floats could be packed here
	float4 LightmapTexCoord2And3	:	TEXCOORD7;
};
 
//==========================================================================//
//	PS Entry Point
//==========================================================================//
float4 main(PS_INPUT i) : COLOR
{
    return 0.0f;
}